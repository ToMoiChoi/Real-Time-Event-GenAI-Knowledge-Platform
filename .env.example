# Environment Configuration for Real-Time Event & GenAI Knowledge Platform

# Kafka & Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLICKSTREAM_TOPIC=clickstream.events
KAFKA_FRAUD_TOPIC=fraud.alerts
KAFKA_CDC_TOPIC_PREFIX=postgres_cdc

# Storage & Lakehouse (MinIO / S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123
S3_ENDPOINT=http://localhost:9000
ICEBERG_REST_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3://lakehouse/warehouse

# Serving (ClickHouse)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse123
CLICKHOUSE_DB=analytics

# Vector Databases
MILVUS_HOST=localhost
MILVUS_PORT=19530
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1-aws

# GenAI & LLM Services
OPENAI_API_KEY=your_openai_api_key_or_vllm_key
VLLM_BASE_URL=http://localhost:8000/v1
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=realtime-genai-platform
LANGSMITH_TRACING=true

# Telemetry & Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
